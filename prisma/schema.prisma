generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  estudante
  professor
  administrador
}

enum TipoConteudo {
  texto
  midia_embedada
  material_anexo
}

model Usuario {
  id            String   @id @db.Uuid
  email         String   @unique @db.VarChar(255)
  papel         Papel
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  credencial         Credencial?
  sessoes            Sessao[]
  perfil_estudante   PerfilEstudante?
  perfil_professor   PerfilProfessor?
  preferencias       Preferencia[]
  visibilidades      Visibilidade[]
  tokens_recuperacao TokenRecuperacao[]
  cursos             Curso[]
  conclusoes         ConclusaoAula[]

  @@map("usuario")
}

model Credencial {
  usuario_id    String   @id @db.Uuid
  hash_senha    String   @db.Text
  atualizada_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("credencial")
}

model Sessao {
  id          String    @id @db.Uuid
  usuario_id  String    @db.Uuid
  criado_em   DateTime  @default(now())
  expira_em   DateTime
  revogada_em DateTime?

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([expira_em])
  @@map("sessao")
}

model PerfilEstudante {
  usuario_id    String   @id @db.Uuid
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("perfil_estudante")
}

model PerfilProfessor {
  usuario_id    String   @id @db.Uuid
  bio           String?  @db.Text
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("perfil_professor")
}

model Preferencia {
  usuario_id String   @db.Uuid
  chave       String   @db.VarChar(100)
  valor       Json

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, chave])
  @@map("preferencias")
}

model Visibilidade {
  usuario_id String   @db.Uuid
  chave       String   @db.VarChar(100)
  visivel     Boolean

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, chave])
  @@map("visibilidade")
}

model Curso {
  id            String   @id @db.Uuid
  titulo        String   @db.Text
  dono_id       String   @db.Uuid
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  dono    Usuario  @relation(fields: [dono_id], references: [id], onDelete: Cascade)
  modulos Modulo[]

  @@index([dono_id])
  @@map("curso")
}

model Modulo {
  id            String   @id @db.Uuid
  curso_id      String   @db.Uuid
  titulo        String   @db.Text
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  curso Curso @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  aulas Aula[]

  @@index([curso_id])
  @@map("modulo")
}

model Aula {
  id            String   @id @db.Uuid
  modulo_id     String   @db.Uuid
  titulo        String   @db.Text
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  modulo     Modulo         @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  conteudos  ConteudoAula[]
  conclusoes ConclusaoAula[]
  arquivos   Arquivo[]

  @@index([modulo_id])
  @@map("aula")
}

model ConteudoAula {
  id            String       @id @db.Uuid
  aula_id       String       @db.Uuid
  tipo          TipoConteudo
  posicao       Int
  dados         Json
  criado_em     DateTime     @default(now())
  atualizado_em DateTime     @updatedAt

  aula Aula @relation(fields: [aula_id], references: [id], onDelete: Cascade)

  @@unique([aula_id, posicao])
  @@map("conteudo_aula")
}

model Arquivo {
  id            String   @id @db.Uuid
  aula_id       String   @db.Uuid
  nome          String   @db.VarChar(255)
  mime          String   @db.VarChar(100)
  tamanho       Int
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  aula Aula @relation(fields: [aula_id], references: [id], onDelete: Cascade)

  @@index([aula_id])
  @@map("arquivo")
}

model ConclusaoAula {
  id            String   @id @db.Uuid
  aula_id       String   @db.Uuid
  usuario_id    String   @db.Uuid
  concluida_em  DateTime
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  aula    Aula    @relation(fields: [aula_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([aula_id])
  @@index([usuario_id])
  @@index([aula_id, usuario_id])
  @@map("conclusao_aula")
}

model TokenRecuperacao {
  id         String   @id @db.Uuid
  usuario_id String   @db.Uuid
  hash_token String   @unique @db.VarChar(64)
  criado_em  DateTime @default(now())
  expira_em  DateTime

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("token_recuperacao")
}
