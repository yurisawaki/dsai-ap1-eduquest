generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  estudante
  professor
  administrador
}

enum TipoConteudo {
  texto
  midia_embedada
  material_anexo
}

enum TipoQuestao {
  multipla_escolha
  verdadeiro_falso
  numerica
  dissertativa
}

enum StatusTentativaAvaliacao {
  aguardando_correcao
  corrigida
}

model Usuario {
  id            String   @id @db.Uuid
  email         String   @unique @db.VarChar(255)
  papel         Papel
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  credencial         Credencial?
  sessoes            Sessao[]
  perfil_estudante   PerfilEstudante?
  perfil_professor   PerfilProfessor?
  preferencias       Preferencia[]
  visibilidades      Visibilidade[]
  tokens_recuperacao TokenRecuperacao[]
  cursos             Curso[]
  conclusoes         ConclusaoAula[]
  tentativas         Tentativa[]
  tentativas_avaliacao TentativaAvaliacao[]
  eventos_xp         EventoXp[]
  saldo_xp           SaldoXp?

  @@map("usuario")
}

model Credencial {
  usuario_id    String   @id @db.Uuid
  hash_senha    String   @db.Text
  atualizada_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("credencial")
}

model Sessao {
  id          String    @id @db.Uuid
  usuario_id  String    @db.Uuid
  criado_em   DateTime  @default(now())
  expira_em   DateTime
  revogada_em DateTime?

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([expira_em])
  @@map("sessao")
}

model PerfilEstudante {
  usuario_id    String   @id @db.Uuid
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("perfil_estudante")
}

model PerfilProfessor {
  usuario_id    String   @id @db.Uuid
  bio           String?  @db.Text
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("perfil_professor")
}

model Preferencia {
  usuario_id String   @db.Uuid
  chave       String   @db.VarChar(100)
  valor       Json

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, chave])
  @@map("preferencias")
}

model Visibilidade {
  usuario_id String   @db.Uuid
  chave       String   @db.VarChar(100)
  visivel     Boolean

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, chave])
  @@map("visibilidade")
}

model Curso {
  id            String   @id @db.Uuid
  titulo        String   @db.Text
  dono_id       String   @db.Uuid
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  dono    Usuario  @relation(fields: [dono_id], references: [id], onDelete: Cascade)
  modulos    Modulo[]
  avaliacoes Avaliacao[]
  config_xp  ConfigXpCurso?

  @@index([dono_id])
  @@map("curso")
}

model Modulo {
  id            String   @id @db.Uuid
  curso_id      String   @db.Uuid
  titulo        String   @db.Text
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  curso    Curso     @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  aulas    Aula[]
  questoes Questao[]

  @@index([curso_id])
  @@map("modulo")
}

model Aula {
  id            String   @id @db.Uuid
  modulo_id     String   @db.Uuid
  titulo        String   @db.Text
  publicado     Boolean  @default(false)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  modulo     Modulo         @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  conteudos  ConteudoAula[]
  conclusoes ConclusaoAula[]
  arquivos   Arquivo[]

  @@index([modulo_id])
  @@map("aula")
}

model ConteudoAula {
  id            String       @id @db.Uuid
  aula_id       String       @db.Uuid
  tipo          TipoConteudo
  posicao       Int
  dados         Json
  criado_em     DateTime     @default(now())
  atualizado_em DateTime     @updatedAt

  aula Aula @relation(fields: [aula_id], references: [id], onDelete: Cascade)

  @@unique([aula_id, posicao])
  @@map("conteudo_aula")
}

model Arquivo {
  id            String   @id @db.Uuid
  aula_id       String   @db.Uuid
  nome          String   @db.VarChar(255)
  mime          String   @db.VarChar(100)
  tamanho       Int
  conteudo      Bytes
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  aula Aula @relation(fields: [aula_id], references: [id], onDelete: Cascade)

  @@index([aula_id])
  @@map("arquivo")
}

model ConclusaoAula {
  id            String   @id @db.Uuid
  aula_id       String   @db.Uuid
  usuario_id    String   @db.Uuid
  concluida_em  DateTime
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  aula    Aula    @relation(fields: [aula_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([aula_id])
  @@index([usuario_id])
  @@unique([aula_id, usuario_id])
  @@map("conclusao_aula")
}

model TokenRecuperacao {
  id         String   @id @db.Uuid
  usuario_id String   @db.Uuid
  hash_token String   @unique @db.VarChar(64)
  criado_em  DateTime @default(now())
  expira_em  DateTime

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("token_recuperacao")
}

model Questao {
  id            String      @id @db.Uuid
  modulo_id     String      @db.Uuid
  tipo          TipoQuestao
  enunciado     String      @db.Text
  explicacao    String?     @db.Text
  gabarito      Json?
  publicado     Boolean     @default(false)
  criado_em     DateTime    @default(now())
  atualizado_em DateTime    @updatedAt

  modulo       Modulo        @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  alternativas Alternativa[]
  tentativas   Tentativa[]
  avaliacoes   AvaliacaoQuestao[]
  respostas    RespostaAvaliacao[]

  @@index([modulo_id])
  @@map("questao")
}

model Alternativa {
  id            String   @id @db.Uuid
  questao_id    String   @db.Uuid
  texto         String   @db.Text
  correta       Boolean
  posicao       Int
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  questao Questao @relation(fields: [questao_id], references: [id], onDelete: Cascade)

  @@unique([questao_id, posicao])
  @@map("alternativa")
}

model Tentativa {
  id            String   @id @db.Uuid
  questao_id    String   @db.Uuid
  usuario_id    String   @db.Uuid
  resposta      Json
  acerto        Boolean?
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  questao Questao @relation(fields: [questao_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([questao_id])
  @@index([usuario_id])
  @@map("tentativa")
}

model Avaliacao {
  id             String   @id @db.Uuid
  curso_id       String   @db.Uuid
  titulo         String   @db.Text
  tentativas_max Int
  abre_em        DateTime
  fecha_em       DateTime
  publicado      Boolean  @default(false)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  curso      Curso                @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  questoes   AvaliacaoQuestao[]
  tentativas TentativaAvaliacao[]

  @@index([curso_id])
  @@map("avaliacao")
}

model AvaliacaoQuestao {
  avaliacao_id  String   @db.Uuid
  questao_id    String   @db.Uuid
  peso          Decimal  @db.Decimal(7, 2)
  posicao       Int
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  avaliacao Avaliacao @relation(fields: [avaliacao_id], references: [id], onDelete: Cascade)
  questao   Questao   @relation(fields: [questao_id], references: [id], onDelete: Cascade)

  @@id([avaliacao_id, questao_id])
  @@unique([avaliacao_id, posicao])
  @@index([questao_id])
  @@map("avaliacao_questao")
}

model TentativaAvaliacao {
  id            String                   @id @db.Uuid
  avaliacao_id  String                   @db.Uuid
  usuario_id    String                   @db.Uuid
  status        StatusTentativaAvaliacao
  nota          Decimal?                 @db.Decimal(4, 2)
  enviada_em    DateTime
  criado_em     DateTime                 @default(now())
  atualizado_em DateTime                 @updatedAt

  avaliacao Avaliacao           @relation(fields: [avaliacao_id], references: [id], onDelete: Cascade)
  usuario   Usuario             @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  respostas RespostaAvaliacao[]

  @@index([avaliacao_id])
  @@index([usuario_id])
  @@map("tentativa_avaliacao")
}

model RespostaAvaliacao {
  id            String   @id @db.Uuid
  tentativa_id  String   @db.Uuid
  questao_id    String   @db.Uuid
  resposta      Json
  acerto        Boolean?
  pontos        Decimal? @db.Decimal(7, 2)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  tentativa TentativaAvaliacao @relation(fields: [tentativa_id], references: [id], onDelete: Cascade)
  questao   Questao            @relation(fields: [questao_id], references: [id], onDelete: Cascade)

  @@unique([tentativa_id, questao_id])
  @@index([questao_id])
  @@map("resposta_avaliacao")
}

// D7 (SPEC/2026-10-02-xp-niveis.md §5): XP e níveis

enum OrigemXp {
  conclusao_aula
  acerto_questao
  entrega_avaliacao
  nota_avaliacao
}

// §5.1 — linha única, criada na migração com os padrões (U-1–U-3)
model ConfigXpGlobal {
  id                   String   @id @db.Uuid
  xp_conclusao_aula    Int      @default(10)
  xp_acerto_questao    Int      @default(5)
  xp_entrega_avaliacao Int      @default(20)
  xp_por_ponto_nota    Int      @default(3)
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  @@map("config_xp_global")
}

// §5.2 — ajuste por curso (null = usa o global; teto 2× global aplicado no uso, R-X13)
model ConfigXpCurso {
  curso_id             String   @id @db.Uuid
  xp_conclusao_aula    Int?
  xp_acerto_questao    Int?
  xp_entrega_avaliacao Int?
  xp_por_ponto_nota    Int?
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  curso Curso @relation(fields: [curso_id], references: [id], onDelete: Cascade)

  @@map("config_xp_curso")
}

// §5.3 — somente inclusão; referencia_id e curso_id sem FK (R-X20)
model EventoXp {
  id              String   @id @db.Uuid
  usuario_id      String   @db.Uuid
  origem          OrigemXp
  referencia_id   String   @db.Uuid
  curso_id        String   @db.Uuid
  chave           String   @db.Text
  xp              Int
  nota_referencia Decimal? @db.Decimal(4, 2)
  concedido_em    DateTime
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, chave])
  @@index([usuario_id, concedido_em])
  @@map("evento_xp")
}

// §5.4 — xp_total = Σ evento_xp.xp; nivel = máximo atingido (R-X17)
model SaldoXp {
  usuario_id    String   @id @db.Uuid
  xp_total      Int      @default(0)
  nivel         Int      @default(1)
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("saldo_xp")
}
